# Public ports
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000

# Local PostgreSQL credentials used by the Compose stack
POSTGRES_DB=genetic_universe
POSTGRES_USER=genetic
POSTGRES_PASSWORD=genetic

# Browser-facing URLs. These are baked into the Next.js client at image build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Include both common local browser origins by default.
GENETIC_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
